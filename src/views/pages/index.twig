{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}

{# ---------------------------------------------------------------------------
   Cats & Dogs Club — custom homepage per approved Stitch design.
   Sections: hero → shop-by-pet portals → grooming → categories →
   best sellers (live) → promo banner → brands → new arrivals (live) →
   why us → visit us.
--------------------------------------------------------------------------- #}

{% extends "layouts.master" %}

{% set whatsapp_svg = '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>' %}

{# Editable content data — update labels/images/links here. #}
{% set shop_categories = [
  { label: 'الطعام',          img: 'images/category-food.jpg' },
  { label: 'المكافآت',        img: 'images/category-treats.jpg' },
  { label: 'العناية والنظافة', img: 'images/category-grooming.jpg' },
  { label: 'الألعاب',         img: 'images/category-toys.jpg' },
  { label: 'الإكسسوارات',     img: 'images/category-accessories.jpg' },
  { label: 'مستلزمات المشي',  img: 'images/category-walking.jpg' },
  { label: 'السفر',           img: 'images/category-travel.jpg' },
  { label: 'المنزل',          img: 'images/category-home.jpg' },
] %}

{% set shop_brands = [
  { name: 'Royal Canin', img: 'images/brand-royal-canin.png' },
  { name: 'Whiskas',     img: 'images/brand-whiskas.png' },
  { name: 'Purina',      img: 'images/brand-purina.png' },
  { name: 'Orijen',      img: 'images/brand-orijen.png' },
  { name: "Hill's",      img: 'images/brand-hills.png' },
  { name: 'Acana',       img: 'images/brand-acana.png' },
] %}

{% block content %}

  {# 3. Hero — shop first #}
  <section class="relative bg-brand overflow-hidden">
    {# Animated background layer (decorative pet pattern) #}
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-overlay">
      <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <g opacity="0.08">
          <path d="M50 50 Q 60 40 70 50 T 90 50" fill="none" stroke="#fdf9f0" stroke-linecap="round" stroke-width="2">
            <animateTransform attributeName="transform" dur="10s" repeatCount="indefinite" type="translate" values="0,0; 5,5; 0,0"></animateTransform>
          </path>
          <circle cx="150" cy="80" fill="#fdf9f0" r="3"></circle>
          <circle cx="160" cy="70" fill="#fdf9f0" r="3"></circle>
          <circle cx="170" cy="80" fill="#fdf9f0" r="3"></circle>
          <circle cx="160" cy="95" fill="#fdf9f0" r="8"></circle>
          <path d="M400 150 C 420 130 450 130 470 150" fill="none" opacity="0.5" stroke="#fdf9f0" stroke-dasharray="4 4" stroke-width="1.5"></path>
          <g transform="translate(600, 100) rotate(15)">
            <circle cx="0" cy="-10" fill="#fdf9f0" r="4"></circle>
            <circle cx="12" cy="-5" fill="#fdf9f0" r="4"></circle>
            <circle cx="-12" cy="-5" fill="#fdf9f0" r="4"></circle>
            <path d="M-10 5 Q 0 15 10 5 L 10 15 Q 0 25 -10 15 Z" fill="#fdf9f0"></path>
          </g>
          <path d="M100 300 Q 150 250 200 300 T 300 300" fill="none" stroke="#fdf9f0" stroke-dasharray="2 6" stroke-width="1"></path>
        </g>
      </svg>
    </div>
    {# Soft beige decorative icons #}
    <span class="material-symbols-outlined cds-decor-icon" style="top: 15%; right: 10%; font-size: 48px; transform: rotate(15deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon" style="bottom: 20%; left: 15%; font-size: 36px; transform: rotate(-20deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon" style="top: 30%; left: 40%; font-size: 24px; transform: rotate(45deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon" style="bottom: 10%; right: 30%; font-size: 28px; transform: rotate(10deg);">cruelty_free</span>
    <span class="material-symbols-outlined cds-decor-icon" style="top: 10%; left: 10%; font-size: 20px; transform: rotate(-10deg);">star</span>
    <span class="material-symbols-outlined cds-decor-icon" style="top: 40%; right: 40%; font-size: 32px; transform: rotate(-10deg);">bone</span>
    <span class="material-symbols-outlined cds-decor-icon" style="bottom: 30%; left: 10%; font-size: 28px; transform: rotate(20deg);">toys</span>
    <span class="material-symbols-outlined cds-decor-icon" style="top: 20%; left: 20%; font-size: 40px; transform: rotate(-30deg);">pets</span>
    <svg class="cds-decor-icon w-64 h-64" style="top: -10%; left: 30%; opacity: 0.1;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path d="M45.7,-76.4C58.9,-69.1,68.9,-54.6,77.3,-40.1C85.7,-25.6,92.5,-11.1,90.4,2.5C88.3,16.1,77.3,28.8,66.8,40.1C56.3,51.4,46.3,61.3,34.2,68.7C22.1,76.1,7.9,81,-6.1,84.6C-20.1,88.2,-34,90.5,-46.1,84.9C-58.2,79.3,-68.5,65.8,-76.4,51.5C-84.3,37.2,-89.8,22.1,-89.9,6.9C-90,-8.3,-84.7,-23.6,-76.3,-36.8C-67.9,-50,-56.4,-61.1,-43.1,-68.3C-29.8,-75.5,-14.9,-78.8,0.9,-80.3C16.7,-81.8,32.5,-83.7,45.7,-76.4Z" fill="currentColor" transform="translate(100 100)"></path>
    </svg>

    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-20 flex flex-col md:flex-row items-center gap-12 relative z-10">
      <div class="md:w-1/2 flex flex-col items-start">
        <div class="inline-block bg-white/20 text-deep-charcoal px-4 py-1 rounded-full text-label-sm mb-6 font-bold backdrop-blur-sm">متجر للقطط والكلاب في جدة</div>
        <h1 class="text-headline-lg md:text-headline-display text-deep-charcoal mb-6 font-extrabold text-right w-full">
          كل احتياجات أليفك<br>
          <span class="text-white drop-shadow-sm">في مكان واحد</span>
        </h1>
        <p class="text-body-lg text-deep-charcoal/80 mb-10 max-w-lg font-medium text-right w-full">
          تسوّق منتجات مختارة للقطط والكلاب، واكتشف باقات العناية من Cats &amp; Dogs Club.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a href="{{ link('products') }}" class="bg-deep-charcoal text-white px-10 py-4 rounded-md hover:bg-black transition-colors duration-300 text-lg font-bold flex items-center justify-center gap-2 shadow-lg">
            تسوّق الآن <span class="material-symbols-outlined">shopping_cart</span>
          </a>
          {# Grooming packages live on the storefront products page until a dedicated page is created #}
          <a href="{{ link('products') }}" class="bg-transparent border-2 border-deep-charcoal text-deep-charcoal px-8 py-4 rounded-md hover:bg-deep-charcoal hover:text-white transition-colors duration-300 text-lg font-bold flex items-center justify-center gap-2">
            استكشف باقات العناية <span class="material-symbols-outlined">spa</span>
          </a>
        </div>
      </div>
      <div class="md:w-1/2 relative flex justify-center items-center w-full">
        <div class="absolute top-1/2 right-1/2 w-96 h-96 bg-white rounded-full mix-blend-overlay blur-3xl opacity-30 -z-10 translate-x-1/2 -translate-y-1/2"></div>
        <img src="{{ 'images/hero-dog-cat.jpg' | asset }}" alt="قط وكلب من Cats & Dogs Club"
             class="w-full h-auto object-cover z-10 relative drop-shadow-2xl rounded-2xl scale-105 origin-bottom border-4 border-white/20"
             fetchpriority="high" loading="eager" width="512" height="512">
      </div>
    </div>
  </section>

  {# 4. Shop by pet portals #}
  <section class="py-12 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <a class="group relative rounded-xl overflow-hidden block aspect-[16/9] shadow-sm hover:shadow-lg transition-shadow duration-300" href="{{ link('categories') }}">
        <div class="absolute inset-0 bg-gradient-to-t from-deep-charcoal/80 to-transparent z-10"></div>
        <img src="{{ 'images/portal-cats.jpg' | asset }}" alt="تسوّق للقطط"
             class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
        <div class="absolute bottom-0 right-0 p-8 z-20 w-full flex justify-between items-end">
          <span class="bg-brand text-white w-10 h-10 rounded-full flex items-center justify-center transform group-hover:-translate-x-2 transition-transform">
            <span class="material-symbols-outlined">arrow_forward</span>
          </span>
          <h2 class="text-headline-lg text-warm-ivory">للقطط</h2>
        </div>
      </a>
      <a class="group relative rounded-xl overflow-hidden block aspect-[16/9] shadow-sm hover:shadow-lg transition-shadow duration-300" href="{{ link('categories') }}">
        <div class="absolute inset-0 bg-gradient-to-t from-deep-charcoal/80 to-transparent z-10"></div>
        {# NOTE: original design image URL was inaccessible (403); hero photo reused as stand-in. #}
        <img src="{{ 'images/hero-dog-cat.jpg' | asset }}" alt="تسوّق للكلاب"
             class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
        <div class="absolute bottom-0 right-0 p-8 z-20 w-full flex justify-between items-end">
          <span class="bg-brand text-white w-10 h-10 rounded-full flex items-center justify-center transform group-hover:-translate-x-2 transition-transform">
            <span class="material-symbols-outlined">arrow_forward</span>
          </span>
          <h2 class="text-headline-lg text-warm-ivory">للكلاب</h2>
        </div>
      </a>
    </div>
  </section>

  {# 5. Grooming feature #}
  <section class="py-16 bg-deep-charcoal text-warm-ivory relative overflow-hidden">
    <span class="material-symbols-outlined cds-decor-icon !text-brand/20" style="top: 20%; right: 15%; font-size: 48px; transform: rotate(15deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon !text-brand/20" style="bottom: 10%; right: 40%; font-size: 32px; transform: rotate(-10deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon !text-brand/20" style="top: 30%; right: 30%; font-size: 24px; transform: rotate(45deg);">spa</span>
    <span class="material-symbols-outlined cds-decor-icon !text-brand/20" style="bottom: 20%; right: 20%; font-size: 40px; transform: rotate(-20deg);">pets</span>
    {# NOTE: original design background image URL was inaccessible (403); charcoal gradient used instead. #}
    <div class="absolute inset-0 bg-gradient-to-l from-[#2a2a2a] via-deep-charcoal/90 to-deep-charcoal z-0 w-full md:w-2/3"></div>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-20 flex flex-col md:flex-row items-center md:justify-end">
      <div class="md:w-1/2 flex flex-col items-end w-full">
        <div class="flex items-center gap-2 mb-4 justify-end text-brand">
          <span class="material-symbols-outlined fill-icon text-3xl">pets</span>
        </div>
        <h2 class="text-headline-lg md:text-headline-display mb-2 text-right w-full">عناية متكاملة</h2>
        <p class="text-headline-md text-warm-sand mb-6 text-right w-full">نظافة، راحة، أناقة</p>
        <p class="text-body-lg text-surface-container-high mb-8 max-w-md text-right w-full">نوفر خدمات عناية احترافية في بيئة مريحة لأليفك. فريقنا المتخصص يهتم بأدق التفاصيل لضمان تجربة فاخرة.</p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a href="{{ link('products') }}" class="bg-transparent border-2 border-brand text-brand px-8 py-3 rounded-md hover:bg-brand hover:text-white transition-colors duration-300 text-label-sm font-bold text-center">استكشف باقات العناية</a>
          <a href="https://wa.me/966544416547" target="_blank" rel="noopener" class="bg-whatsapp text-white px-8 py-3 rounded-md hover:bg-whatsapp-dark transition-colors duration-300 text-label-sm flex items-center justify-center gap-2 font-bold">
            تواصل عبر واتساب {{ whatsapp_svg | raw }}
          </a>
        </div>
      </div>
    </div>
  </section>

  {# 6. Shop by category #}
  <section class="py-12 bg-warm-ivory border-t border-outline-variant/20 relative overflow-hidden">
    <span class="material-symbols-outlined cds-decor-icon !text-outline-variant/10" style="top: 10%; right: 80%; font-size: 24px; transform: rotate(45deg);">pets</span>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-headline-lg text-deep-charcoal">تسوّق حسب الفئة</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4">
        {% for category in shop_categories %}
          <a class="flex flex-col gap-3 group" href="{{ link('categories') }}">
            <div class="w-full aspect-square rounded-xl overflow-hidden relative bg-soft-cream">
              <img src="{{ category.img | asset }}" alt="{{ category.label }}"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
              <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
            </div>
            <div class="flex justify-center items-center text-center">
              <span class="text-label-sm text-deep-charcoal font-bold group-hover:text-brand transition-colors">{{ category.label }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {# 7. Best sellers — live Salla products #}
  <section class="py-12 bg-cream-bg relative overflow-hidden cds-products">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-headline-lg text-deep-charcoal mb-2">الأكثر طلبًا</h2>
          <p class="text-body-md text-on-surface-variant">اختيارات يحبها أصحاب القطط والكلاب</p>
        </div>
        <a class="text-brand text-label-sm font-bold flex items-center gap-1 hover:gap-2 transition-all" href="{{ link('products') }}">
          عرض الكل <span class="material-symbols-outlined text-sm">arrow_back</span>
        </a>
      </div>
      <salla-products-list data-testid="store-home-best-sellers" source="sales" limit="10" shadow-on-hover></salla-products-list>
    </div>
  </section>

  {# 8. Promo banner #}
  <section class="py-12 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="relative rounded-2xl overflow-hidden bg-brand flex flex-col md:flex-row items-center justify-between p-8 md:p-12 shadow-lg">
      <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-overlay">
        <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
          <g opacity="0.08">
            <path d="M50 50 Q 60 40 70 50 T 90 50" fill="none" stroke="#fdf9f0" stroke-linecap="round" stroke-width="2">
              <animateTransform attributeName="transform" dur="10s" repeatCount="indefinite" type="translate" values="0,0; 5,5; 0,0"></animateTransform>
            </path>
            <circle cx="150" cy="80" fill="#fdf9f0" r="3"></circle>
            <circle cx="160" cy="70" fill="#fdf9f0" r="3"></circle>
            <circle cx="170" cy="80" fill="#fdf9f0" r="3"></circle>
            <circle cx="160" cy="95" fill="#fdf9f0" r="8"></circle>
            <path d="M400 150 C 420 130 450 130 470 150" fill="none" opacity="0.5" stroke="#fdf9f0" stroke-dasharray="4 4" stroke-width="1.5"></path>
            <g transform="translate(600, 100) rotate(15)">
              <circle cx="0" cy="-10" fill="#fdf9f0" r="4"></circle>
              <circle cx="12" cy="-5" fill="#fdf9f0" r="4"></circle>
              <circle cx="-12" cy="-5" fill="#fdf9f0" r="4"></circle>
              <path d="M-10 5 Q 0 15 10 5 L 10 15 Q 0 25 -10 15 Z" fill="#fdf9f0"></path>
            </g>
            <path d="M100 300 Q 150 250 200 300 T 300 300" fill="none" stroke="#fdf9f0" stroke-dasharray="2 6" stroke-width="1"></path>
          </g>
        </svg>
      </div>
      <span class="material-symbols-outlined cds-decor-icon" style="top: 10%; right: 5%; font-size: 32px; transform: rotate(25deg);">pets</span>
      <span class="material-symbols-outlined cds-decor-icon" style="bottom: 15%; left: 45%; font-size: 28px; transform: rotate(-15deg);">pets</span>
      <span class="material-symbols-outlined cds-decor-icon" style="top: 20%; right: 40%; font-size: 24px; transform: rotate(10deg);">bone</span>
      <span class="material-symbols-outlined cds-decor-icon" style="bottom: 10%; right: 20%; font-size: 36px; transform: rotate(-20deg);">toys</span>
      <span class="material-symbols-outlined cds-decor-icon" style="top: 30%; left: 20%; font-size: 30px; transform: rotate(15deg);">pets</span>
      <svg class="cds-decor-icon w-48 h-48" style="bottom: -10%; left: 10%; opacity: 0.1;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path d="M45.7,-76.4C58.9,-69.1,68.9,-54.6,77.3,-40.1C85.7,-25.6,92.5,-11.1,90.4,2.5C88.3,16.1,77.3,28.8,66.8,40.1C56.3,51.4,46.3,61.3,34.2,68.7C22.1,76.1,7.9,81,-6.1,84.6C-20.1,88.2,-34,90.5,-46.1,84.9C-58.2,79.3,-68.5,65.8,-76.4,51.5C-84.3,37.2,-89.8,22.1,-89.9,6.9C-90,-8.3,-84.7,-23.6,-76.3,-36.8C-67.9,-50,-56.4,-61.1,-43.1,-68.3C-29.8,-75.5,-14.9,-78.8,0.9,-80.3C16.7,-81.8,32.5,-83.7,45.7,-76.4Z" fill="currentColor" transform="translate(100 100)"></path>
      </svg>
      <div class="relative z-10 flex flex-col items-start w-full md:w-1/2 mb-8 md:mb-0">
        <h2 class="text-headline-lg md:text-headline-display text-white mb-4 text-right w-full">دلّع أليفك أكثر</h2>
        <p class="text-headline-md text-white/90 mb-6 max-w-md text-right w-full">اكتشف تشكيلتنا الجديدة من الألعاب والأسرة الفاخرة بأسعار مميزة.</p>
        <div class="flex w-full">
          <a href="{{ link('offers') }}" class="bg-deep-charcoal text-white px-8 py-3 rounded-md hover:bg-white hover:text-deep-charcoal transition-colors duration-300 text-label-sm flex items-center gap-2 font-bold">
            اكتشف العروض <span class="material-symbols-outlined">local_offer</span>
          </a>
        </div>
      </div>
      <div class="relative z-10 md:w-1/2 flex justify-center w-full">
        <img src="{{ 'images/promo-cat-bed.jpg' | asset }}" alt="ألعاب وأسرة فاخرة للحيوانات الأليفة"
             class="max-h-64 object-contain drop-shadow-2xl" loading="lazy">
      </div>
    </div>
  </section>

  {# 9. Shop by brand #}
  <section class="py-12 bg-warm-ivory border-y border-outline-variant/20 relative overflow-hidden">
    <span class="material-symbols-outlined cds-decor-icon !text-outline-variant/10" style="top: 20%; right: 5%; font-size: 32px; transform: rotate(15deg);">pets</span>
    <span class="material-symbols-outlined cds-decor-icon !text-outline-variant/10" style="bottom: 10%; left: 10%; font-size: 28px; transform: rotate(-20deg);">bone</span>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <h2 class="text-headline-lg text-deep-charcoal mb-8 text-right w-full">تسوّق حسب البراند</h2>
      <div class="flex justify-between items-center flex-wrap gap-8 opacity-70 hover:opacity-100 transition-opacity duration-500">
        {% for brand in shop_brands %}
          {# Brand logos are display-only in the design; link them to the brands page. #}
          <a href="{{ link('brands') }}" aria-label="{{ brand.name }}">
            <img src="{{ brand.img | asset }}" alt="{{ brand.name }}" class="h-12 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-300" loading="lazy">
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {# 10. New arrivals — live Salla products #}
  <section class="py-12 bg-cream-bg relative overflow-hidden cds-products">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
