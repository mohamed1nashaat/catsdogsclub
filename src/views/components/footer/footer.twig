<footer data-testid="store-footer" class="store-footer cds-footer bg-deep-charcoal relative overflow-hidden">
  <span class="material-symbols-outlined cds-decor-icon" aria-hidden="true">pets</span>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop py-12 max-w-container-max mx-auto text-right relative z-10">
    {# Brand & Newsletter #}
    <div class="col-span-1 md:col-span-2">
      <div class="mb-4 flex items-center gap-2">
        <img src="{{ 'images/logo.png' | asset }}" alt="{{ store.name }}" class="h-10 w-auto brightness-0 invert" loading="lazy">
      </div>
      <p class="text-body-md text-warm-sand mb-6 max-w-sm">
        لأن أليفك يستحق الأفضل. نوفر كل ما يحتاجه أليفك من منتجات وخدمات عناية احترافية في مكان واحد.
      </p>
      {# Newsletter — visual only; no newsletter component exists in this Twilight version.
         Hook the form to the merchant's mailing provider here when available. #}
      <form class="flex gap-2 mb-6" onsubmit="return false;">
        <input type="email" required placeholder="ادخل بريدك الالكتروني"
               class="bg-surface-container text-deep-charcoal px-4 py-2 rounded-md focus:outline-none focus:ring-1 focus:ring-brand border-none w-full max-w-xs text-body-md">
        <button type="submit" class="bg-brand text-warm-ivory px-6 py-2 rounded-md text-label-sm hover:opacity-80 transition-all font-bold">اشتراك</button>
      </form>
      <salla-social data-testid="store-footer-social" class="block mb-6"></salla-social>
    </div>

    {# Quick links (merchant-managed footer menu) #}
    <div class="col-span-1">
      <h4 class="text-warm-ivory font-bold mb-4 text-body-md">روابط سريعة</h4>
      <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences class="cds-footer__menu"></salla-menu>
    </div>

    {# Contact #}
    <div class="col-span-1">
      <h4 class="text-warm-ivory font-bold mb-4 text-body-md">تواصل معنا</h4>
      <ul class="flex flex-col gap-3">
        <li class="flex items-center gap-2 text-warm-sand text-label-xs">
          <span class="text-whatsapp flex items-center justify-center">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
          </span>
          <a class="hover:text-white transition-colors ltr" dir="ltr" href="https://wa.me/966544416547" target="_blank" rel="noopener">+966 54 441 6547</a>
        </li>
        <li class="flex items-center gap-2 text-warm-sand text-label-xs">
          <span class="material-symbols-outlined text-brand text-base">mail</span>
          <a href="mailto:support@catsdogsclub.sa" class="hover:text-white transition-colors">support@catsdogsclub.sa</a>
        </li>
        <li class="flex items-center gap-2 text-warm-sand text-label-xs">
          <span class="material-symbols-outlined text-brand text-base">schedule</span>
          يوميًا: 12 م – 12 ص
        </li>
        <li class="flex items-center gap-2 text-warm-sand text-label-xs mt-2">
          <span class="material-symbols-outlined text-brand text-base">location_on</span>
          شارع الكيال، جدة 23434، المملكة العربية السعودية
        </li>
      </ul>
    </div>
  </div>

  {# Bottom bar #}
  <div class="border-t border-outline-variant/10 px-margin-mobile md:px-margin-desktop py-4 flex flex-col md:flex-row justify-between items-center gap-4 text-warm-sand text-label-xs max-w-container-max mx-auto relative z-10">
    <div>© 2026 Cats &amp; Dogs Club. جميع الحقوق محفوظة</div>
    <salla-payments data-testid="store-footer-payments"></salla-payments>
  </div>
</footer>
