{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header data-testid="store-header" class="store-header cds-header sticky top-0 z-50">
  {# 1. Announcement bar #}
  <div class="hidden md:flex bg-deep-charcoal text-warm-ivory text-label-sm items-center justify-between text-center px-margin-desktop py-2 max-w-container-max mx-auto">
    <span>عروض حصرية كل أسبوع <span class="material-symbols-outlined align-middle ml-1 text-brand text-base">redeem</span></span>
    <span>تسوّق منتجات القطط والكلاب <span class="material-symbols-outlined align-middle ml-1 text-brand text-base">pets</span></span>
    <span>اكتشف باقات العناية <span class="material-symbols-outlined align-middle ml-1 text-brand text-base">spa</span></span>
  </div>

  {# 2. Main bar #}
  <div class="bg-warm-ivory border-b border-outline-variant/30 shadow-sm">
    <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto gap-4">

      {# Mobile menu toggle + Logo (right side in RTL) #}
      <div class="flex items-center gap-2 md:ml-8 shrink-0">
        <a data-testid="store-header-mobile-toggle" class="lg:hidden leading-none text-deep-charcoal" href="#mobile-menu" aria-label="فتح القائمة">
          <span class="material-symbols-outlined text-3xl">menu</span>
        </a>
        <a data-testid="store-header-logo" href="{{ store.url }}" class="flex items-center">
          <img fetchpriority="high" width="312" height="218" class="h-10 w-auto" src="{{ store.logo ? store.logo|cdn(175) : 'images/logo.png'|asset }}" alt="{{ store.name }} logo">
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>
      </div>

      {# Navigation links (merchant-managed menus via Salla dashboard) #}
      <nav class="hidden lg:block flex-grow cds-header__menu" aria-label="القائمة الرئيسية">
        <custom-main-menu></custom-main-menu>
      </nav>

      {# Action icons (left side in RTL) #}
      <div class="flex gap-4 md:gap-6 items-center shrink-0">
        {# Search — opens the store search modal provided by master layout #}
        <button type="button" aria-label="بحث" class="text-deep-charcoal hover:text-brand transition-all"
                onclick="salla.event.dispatch('search::open')">
          <span class="material-symbols-outlined text-[28px]">search</span>
        </button>

        {# Wishlist #}
        <a href="{{ link('wishlist') }}" aria-label="المفضلة" class="hidden sm:block text-deep-charcoal hover:text-brand transition-all">
          <span class="material-symbols-outlined text-[28px]">favorite</span>
        </a>

        {# Account #}
        <salla-user-menu data-testid="store-header-user-menu" avatar-only show-trigger></salla-user-menu>

        {# Language & Currency #}
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
        {% endif %}

        {# WhatsApp #}
        <a class="hidden md:flex text-whatsapp hover:text-whatsapp-dark transition-all items-center" href="https://wa.me/966544416547" target="_blank" rel="noopener" aria-label="واتساب">
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
        </a>

        {# Cart with live badge #}
        <salla-cart-summary data-testid="store-header-cart" class="cds-header__cart">
          <span slot="icon" class="material-symbols-outlined text-[28px]">shopping_cart</span>
        </salla-cart-summary>
      </div>
    </div>
  </div>
</header>
