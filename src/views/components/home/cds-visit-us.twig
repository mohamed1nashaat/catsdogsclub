{% set whatsapp_svg = '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>' %}
{#
| Variable    | Type    | Description                                                |
|-------------|---------|------------------------------------------------------------|
| title       | string  | Section headline                                           |
| text        | string  | Supporting paragraph                                       |
| address     | string  | Store address line                                         |
| hours       | string  | Opening hours line                                         |
| map_link    | string  | Map button URL                                             |
| whatsapp    | string  | WhatsApp number (digits only, no +)                        |
| image.url   | string  | Store photo                                                |
| componentId | string  | Component id                                               |
#}
<section component-id="{{ componentId }}" class="py-16 bg-soft-cream relative overflow-hidden">
  <span class="material-symbols-outlined cds-decor-icon !text-outline-variant/15" style="bottom: 10%; right: 10%; font-size: 40px; transform: rotate(10deg);">pets</span>
  <span class="material-symbols-outlined cds-decor-icon !text-outline-variant/15" style="top: 20%; left: 20%; font-size: 32px; transform: rotate(-15deg);">store</span>
  {% set visit_img = image.url matches '~^https?://~' ? image.url : image.url|asset %}
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex flex-col md:flex-row items-center gap-12 relative z-10">
    <div class="md:w-1/2 flex flex-col items-start w-full text-right">
      <h2 class="text-headline-lg md:text-headline-display font-bold text-deep-charcoal mb-4 text-right w-full">{{ title }}</h2>
      <p class="text-body-lg text-on-surface-variant mb-6 text-right w-full">{{ text }}</p>
      <div class="flex items-center gap-2 text-deep-charcoal mb-2 w-full">
        <span class="text-body-lg font-bold text-right">{{ address }}</span>
        <span class="material-symbols-outlined text-brand">location_on</span>
      </div>
      <div class="flex items-center gap-2 text-deep-charcoal mb-8 w-full">
        <span class="text-body-lg font-bold text-right">{{ hours }}</span>
        <span class="material-symbols-outlined text-brand">schedule</span>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href="{{ map_link }}" target="_blank" rel="noopener" class="bg-brand text-white px-8 py-3 rounded-md hover:bg-deep-charcoal transition-colors duration-300 text-label-sm flex items-center justify-center gap-2 font-bold">
          عرض الخريطة <span class="material-symbols-outlined">map</span>
        </a>
        <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener" class="bg-whatsapp text-white px-8 py-3 rounded-md hover:bg-whatsapp-dark transition-colors duration-300 text-label-sm flex items-center justify-center gap-2 font-bold">
          واتساب {{ whatsapp_svg | raw }}
        </a>
      </div>
    </div>
    <div class="md:w-1/2 w-full bg-surface-container rounded-2xl overflow-hidden shadow-lg">
      <img src="{{ visit_img }}" alt="{{ image.alt|default(store.name) }}"
           class="w-full h-auto object-cover" loading="lazy">
    </div>
  </div>
</section>
